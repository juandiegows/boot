    const passPct = Math.max(0, Number(cfg?.retrace50?.passTargetMarginPct ?? 0));
    const passAbs = Math.max(0, Number(cfg?.retrace50?.passTargetMarginAbs ?? 0));
    const passMargin = Math.abs(target) * passPct + passAbs;
    let passed = true;
    if (isFinite(target)) {
      if (dir === 'CALL') passed = Number(curPrice) < (target - passMargin);
      else passed = Number(curPrice) > (target + passMargin);
    }
    if (passed) {
      const hMs = Math.max(0, Number(cfg?.retrace50?.holdMs ?? 0));
      w.holdStartMs = Date.now() - hMs - 1;
      if (cfg.debugSignals) console.log(`[${ticker}] ${tf} retrace50 bypass hold (price passed target) px=${Number(curPrice).toFixed(6)} target=${target.toFixed(6)} passMargin=${passMargin}`);
      pend.waitRetrace50 = w;
      pendingByKey.set(k, pend);
    }
  }
} catch (e) {}

